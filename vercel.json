{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:preview",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/entries", "destination": "/api/entries.json" },
    { "source": "/api/config", "destination": "/api/config.json" },
    { "source": "/showcase/:id", "destination": "/index.html" },
    { "source": "/submit", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://static.heygen.ai; media-src 'self' https:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
  ] }]
}
